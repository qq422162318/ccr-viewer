<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROL PLANE"
                android:textColor="#5EEAD4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="配置"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="刷新"
            android:textColor="#D7E2EF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="保存"
            android:textColor="#042F2E"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2D43" />

    <ScrollView
        android:id="@+id/configScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView style="@style/SectionLabel" android:text="默认提供商" />
            <Spinner
                android:id="@+id/preferredProvider"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:paddingStart="8dp" />

            <TextView style="@style/SectionLabel" android:text="内置路由规则" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <CheckBox
                    android:id="@+id/claudeCodeCb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="claude-code"
                    android:textColor="#E5E7EB"
                    android:buttonTint="#2DD4BF" />
                <CheckBox
                    android:id="@+id/codexCb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="codex"
                    android:textColor="#E5E7EB"
                    android:buttonTint="#2DD4BF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/providersTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="提供商"
                    android:textColor="#5EEAD4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <Button
                    android:id="@+id/addProviderButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_button_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="+ 添加"
                    android:textColor="#042F2E"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/providerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/providersEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="暂无提供商"
                android:textColor="#71839A"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
