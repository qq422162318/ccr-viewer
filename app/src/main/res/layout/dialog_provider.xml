<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView style="@style/DialogLabel" android:text="显示名称" />
        <EditText
            android:id="@+id/dlgName"
            style="@style/DialogInput"
            android:hint="例如 阿里 / 腾讯" />

        <TextView style="@style/DialogLabel" android:text="提供商 ID" />
        <EditText
            android:id="@+id/dlgId"
            style="@style/DialogInput"
            android:hint="唯一 ID" />

        <TextView style="@style/DialogLabel" android:text="协议类型" />
        <Spinner
            android:id="@+id/dlgProtocol"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingStart="8dp" />

        <TextView style="@style/DialogLabel" android:text="Base URL" />
        <EditText
            android:id="@+id/dlgBaseUrl"
            style="@style/DialogInput"
            android:hint="https://api.example.com/v1"
            android:inputType="textUri" />

        <TextView style="@style/DialogLabel" android:text="API Key" />
        <EditText
            android:id="@+id/dlgApiKey"
            style="@style/DialogInput"
            android:hint="sk-..."
            android:inputType="textVisiblePassword" />

        <TextView style="@style/DialogLabel" android:text="模型列表（每行一个，或用逗号分隔）" />
        <EditText
            android:id="@+id/dlgModels"
            style="@style/DialogInput"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="8"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="gpt-6.1-terra" />

        <CheckBox
            android:id="@+id/dlgEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="启用该提供商"
            android:textColor="#E5E7EB"
            android:buttonTint="#2DD4BF" />
    </LinearLayout>
</ScrollView>
