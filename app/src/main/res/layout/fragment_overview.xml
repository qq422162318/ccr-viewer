<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CCR GATEWAY"
                android:textColor="#5EEAD4"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="概览"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="刷新"
            android:textColor="#D7E2EF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="退出"
            android:textColor="#FCA5A5"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2D43" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <TextView style="@style/SectionLabel" android:text="网关状态" />
            <TextView
                android:id="@+id/statusText"
                style="@style/CardText"
                android:text="加载中…" />

            <TextView style="@style/SectionLabel" android:text="代理状态" />
            <TextView
                android:id="@+id/proxyText"
                style="@style/CardText"
                android:text="加载中…" />

            <TextView style="@style/SectionLabel" android:text="用量合计" />
            <TextView
                android:id="@+id/totalsText"
                style="@style/CardText"
                android:text="加载中…" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="13dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最近 30 天总 Token 用量"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tokenTrendStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
                <com.ccr.viewer.UsageTrendView
                    android:id="@+id/tokenTrend"
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView style="@style/SectionLabel" android:text="最近请求" />
            <TextView
                android:id="@+id/recentText"
                style="@style/CardText"
                android:text="加载中…" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
