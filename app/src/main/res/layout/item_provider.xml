<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/pvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/pvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5EEAD4"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pvBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="middle" />

    <TextView
        android:id="@+id/pvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#71839A"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/pvEdit"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="编辑"
            android:textColor="#D7E2EF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/pvToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="停用"
            android:textColor="#D7E2EF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/pvTest"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="测试"
            android:textColor="#D7E2EF"
            android:textSize="12sp" />
        <Button
            android:id="@+id/pvDelete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="删除"
            android:textColor="#FCA5A5"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
